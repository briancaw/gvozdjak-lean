/-
The fifteen moves.  GENERATED by scripts/gen_moves.py from the move signatures; do not edit.

For move `j`, `Cj n a b …` is the list of linear constraints tying the layer parameters and the
core `(s, e; N)` to the target `(a, b; n)`, and `movej` proves that under these constraints a
graceful core yields an `(a, b; n)`-graceful labeling: the layers of Lemma A and the shifted core
are concatenated, and the label and difference counts are checked by `omega` region by region.
-/
import Gvozdjak.Layers

namespace Gvozdjak

/-- Admissibility with the parity condition written modulo 4, so that it is linear. -/
def AdmL (a b n : Nat) : Prop :=
  a ≤ n ∧ b ≤ n ∧ a ≠ b ∧ 2 * a ≤ 2 * b + n + 1 ∧ 2 * b ≤ 2 * a + n + 1 ∧
  n ≤ 2 * (a + b) ∧ 2 * (a + b) ≤ 3 * n ∧
  (((n % 4 = 0 ∨ n % 4 = 3) ∧ (a + b) % 2 = 0) ∨ ((n % 4 = 1 ∨ n % 4 = 2) ∧ (a + b) % 2 = 1))

theorem tri_add4 (n : Nat) : (n + 4) * (n + 4 + 1) / 2 = n * (n + 1) / 2 + (4 * n + 10) := by
  have h : (n + 4) * (n + 4 + 1) = n * (n + 1) + 2 * (4 * n + 10) := by
    simp only [Nat.add_mul, Nat.mul_add]; omega
  rw [h, Nat.add_mul_div_left _ _ (by omega : 0 < 2)]

theorem tri_mod : ∀ n : Nat,
    ((n % 4 = 0 ∨ n % 4 = 3) ∧ (n * (n + 1) / 2) % 2 = 0) ∨
    ((n % 4 = 1 ∨ n % 4 = 2) ∧ (n * (n + 1) / 2) % 2 = 1)
  | 0 => by decide
  | 1 => by decide
  | 2 => by decide
  | 3 => by decide
  | n + 4 => by
      have ih := tri_mod n
      rw [tri_add4]
      generalize n * (n + 1) / 2 = T at ih ⊢
      omega

theorem admissible_iff_admL {a b n : Nat} : Admissible a b n ↔ AdmL a b n := by
  have h := tri_mod n
  unfold Admissible AdmL adiff
  generalize n * (n + 1) / 2 = T at h ⊢
  omega

/-- A graceful labeling can be translated to start at any `lo`. -/
theorem core_of {s e N : Nat} (h : ∃ p, IsGraceful s e N p) (lo : Nat) :
    ∃ p, Spec (lo + s) (lo + e) (ind lo (N + 1)) (ind 1 N) p := by
  obtain ⟨p, hp⟩ := h
  refine ⟨_, ((isGraceful_iff_spec.mp hp).shift lo).congr rfl rfl ?_ (fun _ => rfl)⟩
  intro x
  try dsimp only
  split <;> simp only [ind] <;> omega

/-- Constraints of move 1: layers EH. -/
def C1 (n a b k0 A0 B0 H0 N s e : Nat) : Prop :=
  1 ≤ k0 ∧
  A0 + B0 = k0 ∧
  A0 ≠ B0 ∧
  1 ≤ N ∧
  H0 + ((k0 + 1)) = n + 1 ∧
  n + 1 = (2 * k0 + 1) + (N + 1) ∧
  a = k0 + s ∧
  b = H0 + B0 ∧
  k0 + e + ((N + 1)) = H0 + A0

set_option maxHeartbeats 200000 in
theorem move1 {n a b k0 A0 B0 H0 N s e : Nat} (h : C1 n a b k0 A0 B0 H0 N s e)
    (hc : ∃ p, IsGraceful s e N p) : ∃ p, IsGraceful a b n p := by
  unfold C1 at h
  obtain ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8⟩ := h
  obtain ⟨p0, h0⟩ := hasEH' (κ := k0) (A := A0) (B := B0) (lo := 0) (hi := H0) (g := (N + 1) + 1) (by omega) (by omega) (by omega) (by omega) (by omega)
  obtain ⟨p1, h1⟩ := core_of hc (k0)
  refine ⟨_, isGraceful_iff_spec.mpr ((h1.append h0).congr (by omega) (by omega) ?_ ?_)⟩
  · intro x
    simp only [ind]
    rcases Nat.lt_or_ge x (k0) with hx0 | hx0
    · omega
    rcases Nat.lt_or_ge x (H0) with hx1 | hx1
    · omega
    rcases Nat.lt_or_ge x (n + 1) with hx2 | hx2
    · omega
    omega
  · intro x
    simp only [ind, adiff]
    rcases Nat.lt_or_ge x (1) with hx0 | hx0
    · omega
    rcases Nat.lt_or_ge x ((N + 1)) with hx1 | hx1
    · omega
    rcases Nat.lt_or_ge x ((N + 1) + 1) with hx2 | hx2
    · omega
    rcases Nat.lt_or_ge x (n + 1) with hx3 | hx3
    · omega
    omega

/-- Constraints of move 3: layers EH, EH. -/
def C3 (n a b k0 A0 B0 H0 k1 A1 B1 H1 N s e : Nat) : Prop :=
  1 ≤ k0 ∧
  A0 + B0 = k0 ∧
  A0 ≠ B0 ∧
  1 ≤ k1 ∧
  A1 + B1 = k1 ∧
  A1 ≠ B1 ∧
  1 ≤ N ∧
  H0 + ((k0 + 1)) = n + 1 ∧
  H1 + ((k0 + 1) + (k1 + 1)) = n + 1 ∧
  n + 1 = (2 * k0 + 1) + (2 * k1 + 1) + (N + 1) ∧
  a = k0 + k1 + s ∧
  b = H1 + B1 ∧
  k0 + k1 + e + ((2 * k1 + 1) + (N + 1)) = H0 + A0 ∧
  H0 + B0 = H1 + A1 + ((N + 1))

set_option maxHeartbeats 200000 in
theorem move3 {n a b k0 A0 B0 H0 k1 A1 B1 H1 N s e : Nat} (h : C3 n a b k0 A0 B0 H0 k1 A1 B1 H1 N s e)
    (hc : ∃ p, IsGraceful s e N p) : ∃ p, IsGraceful a b n p := by
  unfold C3 at h
  obtain ⟨c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13⟩ := h
  obtain ⟨p0, h0⟩ := hasEH' (κ := k0) (A := A0) (B := B0) (lo := 0) (hi := H0) (g := (2 * k1 + 1) + (N + 1) + 1) (by omega) (by omega) (by omega) (by omega) (by omega)
  obtain ⟨p1, h1⟩ := hasEH' (κ := k1) (A := A1) (B := B1) (lo := k0) (hi := H1) (g := (N + 1) + 1) (by omega) (by omega) (by omega) (by omega) (by omega)
  obtain ⟨p2, h2⟩ := core_of hc (k0 + k1)
  refine ⟨_, isGraceful_iff_spec.mpr (((h2.append h0).append h1).congr (by omega) (by omega) ?_ ?_)⟩
  · intro x
    simp only [ind]
    rcases Nat.lt_or_ge x (k0) with hx0 | hx0
    · omega
    rcases Nat.lt_or_ge x (k0 + k1) with hx1 | hx1
    · omega
    rcases Nat.lt_or_ge x (H1) with hx2 | hx2
    · omega
    rcases Nat.lt_or_ge x (H0) with hx3 | hx3
    · omega
    rcases Nat.lt_or_ge x (n + 1) with hx4 | hx4
    · omega
    omega
  · intro x
    simp only [ind, adiff]
    rcases Nat.lt_or_ge x (1) with hx0 | hx0
    · omega
    rcases Nat.lt_or_ge x ((N + 1)) with hx1 | hx1
    · omega
    rcases Nat.lt_or_ge x ((N + 1) + 1) with hx2 | hx2
    · omega
    rcases Nat.lt_or_ge x ((2 * k1 + 1) + (N + 1)) with hx3 | hx3
    · omega
    rcases Nat.lt_or_ge x ((2 * k1 + 1) + (N + 1) + 1) with hx4 | hx4
    · omega
    rcases Nat.lt_or_ge x (n + 1) with hx5 | hx5
    · omega
    omega


end Gvozdjak
