/-- Admissibility with the parity condition written modulo 4, so that it is linear. -/
def AdmL (a b n : Nat) : Prop :=
  a ≤ n ∧ b ≤ n ∧ a ≠ b ∧ 2 * a ≤ 2 * b + n + 1 ∧ 2 * b ≤ 2 * a + n + 1 ∧
  n ≤ 2 * (a + b) ∧ 2 * (a + b) ≤ 3 * n ∧
  (((n % 4 = 0 ∨ n % 4 = 3) ∧ (a + b) % 2 = 0) ∨ ((n % 4 = 1 ∨ n % 4 = 2) ∧ (a + b) % 2 = 1))

theorem tri_add4 (n : Nat) : (n + 4) * (n + 4 + 1) / 2 = n * (n + 1) / 2 + (4 * n + 10) := by
  have h : (n + 4) * (n + 4 + 1) = n * (n + 1) + 2 * (4 * n + 10) := by
    simp only [Nat.add_mul, Nat.mul_add]; omega
  rw [h, Nat.add_mul_div_left _ _ (by omega : 0 < 2)]

theorem tri_mod : ∀ n : Nat,
    ((n % 4 = 0 ∨ n % 4 = 3) ∧ (n * (n + 1) / 2) % 2 = 0) ∨
    ((n % 4 = 1 ∨ n % 4 = 2) ∧ (n * (n + 1) / 2) % 2 = 1)
  | 0 => by decide
  | 1 => by decide
  | 2 => by decide
  | 3 => by decide
  | n + 4 => by
      have ih := tri_mod n
      rw [tri_add4]
      generalize n * (n + 1) / 2 = T at ih ⊢
      omega

theorem admissible_iff_admL {a b n : Nat} : Admissible a b n ↔ AdmL a b n := by
  have h := tri_mod n
  unfold Admissible AdmL adiff
  generalize n * (n + 1) / 2 = T at h ⊢
  omega

/-- A graceful labeling can be translated to start at any `lo`. -/
theorem core_of {s e N : Nat} (h : ∃ p, IsGraceful s e N p) (lo : Nat) :
    ∃ p, Spec (lo + s) (lo + e) (ind lo (N + 1)) (ind 1 N) p := by
  obtain ⟨p, hp⟩ := h
  refine ⟨_, ((isGraceful_iff_spec.mp hp).shift lo).congr rfl rfl ?_ (fun _ => rfl)⟩
  intro x
  try dsimp only
  split <;> simp only [ind] <;> omega

